# 1. Määra faili asukoht ja varunduse kaust
$csvPath = "C:\Users\Administrator\kasutajanimed.csv"
$backupRoot = "C:\Backup"
$kuupaev = Get-Date -Format "dd.MM.yyyy"

# Loo varunduse kaust, kui seda veel pole
if (-not (Test-Path $backupRoot)) {
    New-Item -Path $backupRoot -ItemType Directory
}

# 2. Loe kasutajad CSV-st
if (Test-Path $csvPath) {
    $kasutajad = Import-Csv -Path $csvPath
    
    foreach ($k in $kasutajad) {
        # Võtame kasutajatunnuse otse CSV-st
        $kasutaja = $k.Kasutajatunnus
        $koduKataloog = "C:\Users\$kasutaja"
        $sihtZip = "$backupRoot\$kasutaja-$kuupaev.zip"

        # 3. Kontrolli kodukataloogi ja loo ZIP
        if (Test-Path $koduKataloog) {
            try {
                Compress-Archive -Path "$koduKataloog\*" -DestinationPath $sihtZip -Force
                Write-Host "Kasutaja $kasutaja kodukataloog varundatud."
            }
            catch {
                Write-Host "Viga kasutaja $kasutaja varundamisel."
            }
        }
        else {
            Write-Host "Kasutajat $kasutaja või tema kataloogi ei leitud."
        }
    }
}
else {
    Write-Host "VIGA: Faili $csvPath ei leitud!"
}
