# Read-Host käskude abil küsitakse kasutaja ees- ja perenimi ning salvestatakse need muutujatesse eesnimi ja perenimi
$eesnimi = Read-Host "Sisesta oma eesnimi"
$perenimi = Read-Host "Sisesta oma perenimi"

# Regulaaravaldise -notmatch '^[A-Za-z]+$' abil kontrollitakse, et sisestatud tekst sisaldaks ainult ladina tähti (A-Z)
if ($eesnimi -notmatch '^[A-Za-z]+$') {
    Write-Host "Eesnimi võib sisaldada ainult ladina tähti!" -ForegroundColor Red
    exit
}

if ($perenimi -notmatch '^[A-Za-z]+$') {
    Write-Host "Perenimi võib sisaldada ainult ladina tähti!" -ForegroundColor Red
    exit
}

# Stringide manipuleerimine: liidetakse nimed punktiga, muudetakse kõik tähed väikseks (.ToLower) ja luuakse sisselogimisnimi (@meremaa-kool.local)
$kasutajanimi = ($eesnimi + "." + $perenimi).ToLower()
$taisnimi = "$eesnimi $perenimi"
$upn = $kasutajanimi + "@meremaa-kool.local"
$parool = ConvertTo-SecureString "Parool1!" -AsPlainText -Force

Write-Host "Loodav kasutaja on $kasutajanimi" -ForegroundColor Cyan

# Get-ADUser käsk koos -Filter parameetriga kontrollib, kas sisestatud SamAccountName on Active Directorys juba dubleeritud
$existingUser = Get-ADUser -Filter "SamAccountName -eq '$kasutajanimi'" -ErrorAction SilentlyContinue

if ($existingUser) {
    Write-Host "Kasutaja $kasutajanimi on juba domeenis olemas!" -ForegroundColor Yellow
    exit
}

# New-ADUser cmdlet-i käivitamine try-catch plokis, mis edastab kogutud atribuudid serverile uue konto loomiseks
try {
    New-ADUser -Name $kasutajanimi `
        -DisplayName $taisnimi `
        -GivenName $eesnimi `
        -Surname $perenimi `
        -SamAccountName $kasutajanimi `
        -UserPrincipalName $upn `
        -AccountPassword $parool `
        -Enabled $true
    
    Write-Host "Kasutaja $kasutajanimi loodi edukalt domeeni meremaa-kool.local!" -ForegroundColor Green
}
catch {
    Write-Host "Viga: $($_.Exception.Message)" -ForegroundColor Red
}
