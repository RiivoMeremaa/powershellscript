function Translit {

    param(
        [string] $inputString
    )
        $Translit = @{
        [char] 'ä' = "a"
        [char] 'ö' = "o"
        [char] 'ü' = "u"
        [char] 'õ' = "o"
        }

    foreach ($character in $inputCharacter = $inputString.ToCharArray())
    {
        if ($Translit[$character] -cne $Null ){
        $outputString += $Translit[$character]
        } else {
            $outputString += $character
        }
    }
    Write-Output $outputString
}

